{
  "name": "9router-command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs --trigger-states",
    "layout:test": "node scripts/layout-check.mjs",
    "layout:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/hud-layout-rules.mjs",
    "perf": "node scripts/perf.mjs",
    "status:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/status-rules.mjs",
    "identity:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/identity-rules.mjs",
    "roam:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/roam-rules.mjs",
    "status:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/explain-status.mjs",
    "build:model": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-robot-model.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
